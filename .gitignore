# ============================================================
#  .gitignore — Bicicletaria do Grau 5.0
#  Gerado em: 2026-10-02
# ============================================================

# ----------------------------
# Sistemas Operacionais
# ----------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ----------------------------
# Editores e IDEs
# ----------------------------
# VSCode
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (WebStorm, IDEA, etc.)
.idea/
*.iml
*.iws

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project

# Vim / Neovim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# ----------------------------
# Node.js (caso future-proof)
# ----------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build output
dist/
build/
.cache/
.parcel-cache/
.next/
out/

# ----------------------------
# Variáveis de Ambiente
# ----------------------------
.env
.env.local
.env.development
.env.staging
.env.production
.env.test
*.env

# ----------------------------
# Logs
# ----------------------------
logs/
*.log
log/

# ----------------------------
# Temporários e Cache
# ----------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo
push_github.bat
.sass-cache/
.eslintcache
.stylelintcache

# ----------------------------
# Documentação Interna / Briefing
# (Mantido localmente, não publicado)
# ----------------------------
.docs/

# ----------------------------
# Certificados e Segredos
# ----------------------------
*.pem
*.key
*.cert
*.crt
secrets/
credentials/
